# RPC endpoints
VITE_RPC_PRIMARY=https://1rpc.io/sepolia
VITE_RPC_FALLBACK=https://ethereum-sepolia-rpc.publicnode.com

# WalletConnect project ID
VITE_WALLETCONNECT_PROJECT_ID=

# LLM provider selection (mistral | gemini, default: mistral)
VITE_INTENT_PROVIDER=mistral

# Mistral API key (optional: enables LLM fallback for complex natural-language parsing)
# Note: VITE_* vars are exposed in the browser bundle.
# Never send private keys or other secrets through this path.
VITE_MISTRAL_API_KEY=
VITE_MISTRAL_MODEL=open-mistral-7b

# Optional Gemini provider configuration.
# Used only when VITE_INTENT_PROVIDER=gemini.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=
