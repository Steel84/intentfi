# RPC endpoints
VITE_RPC_PRIMARY=https://1rpc.io/sepolia
VITE_RPC_FALLBACK=https://ethereum-sepolia-rpc.publicnode.com

# Gemini API key (optional: enables LLM fallback for natural-language parsing)
# Get a free key at https://aistudio.google.com/apikey
# Note: VITE_* vars are exposed in the browser bundle.
# The Gemini key is used ONLY for intent parsing (user swap phrases).
# Never send private keys or secrets through this path.
VITE_GEMINI_API_KEY=

# Gemini model (optional, default: gemini-3.6-flash)
VITE_GEMINI_MODEL=

# WalletConnect project ID
VITE_WALLETCONNECT_PROJECT_ID=
