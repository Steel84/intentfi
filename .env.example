# RPC endpoints
VITE_RPC_PRIMARY=https://1rpc.io/sepolia
VITE_RPC_FALLBACK=https://ethereum-sepolia-rpc.publicnode.com

# Do not put provider secrets in VITE_* variables: Vite exposes them in the browser.
# The shipped UI uses the deterministic parser; use a server-side proxy for an LLM parser.

# WalletConnect project ID
VITE_WALLETCONNECT_PROJECT_ID=
