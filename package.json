{
  "name": "intentfi",
  "version": "0.1.0",
  "description": "AI-assisted on-chain intent execution system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/lint.mjs",
    "format:check": "node scripts/lint.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0",
    "@tanstack/react-query": "^5.59.0",
    "connectkit": "^1.8.0",
    "@wagmi/core": "^2.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vitest": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
